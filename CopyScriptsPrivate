        keyVerified = true
        setStatus("✅ Key verified! You can now enter a link.", false, true)
        
        linkBox.Active = true
        linkBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        executeButton.Active = true
        executeButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        executeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        executeButton.Text = "EXECUTE"
        
        verifyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        verifyButton.Text = "✓ VERIFIED"
        verifyButton.Active = false
        
        return true
    else
        kickPlayer("Key isn't correct! Try again later.")
        return false
    end
end

-- Check if response is valid (not HTML error)
local function isValidContent(content)
    -- Check if content is HTML error page
    if string.find(content, "<html") or string.find(content, "<!DOCTYPE") then
        if string.find(content, "502") or string.find(content, "Bad Gateway") or 
           string.find(content, "404") or string.find(content, "Not Found") or
           string.find(content, "403") or string.find(content, "Forbidden") then
            return false, "Server error: Link returned HTML error page"
        end
    end
    
    -- Check if content is too short or suspicious
    if #content < 10 then
        return false, "Content too short or empty"
    end
    
    return true, "Valid"
end

-- Check blocked domains
local function isBlockedDomain(link)
    local blockedDomains = {
        "pastebin.com",
        "github.com",
        "raw.github.com",
        "gist.github.com",
        "youtube.com",
        "google.com"
    }
    
    local lowerLink = string.lower(link)
    for _, domain in ipairs(blockedDomains) do
        if string.find(lowerLink, domain) then
            return true
        end
    end
    return false
end

-- Execute link with better error handling
local function executeLink()
    if not keyVerified then
        setStatus("Please verify your key first!", true, false)
        return
    end
    
    local rawLink = linkBox.Text
    if rawLink == "" then
        setStatus("Please enter a link!", true, false)
        return
    end
    
    if isBlockedDomain(rawLink) then
        setStatus("❌ GitHub/Pastebin not supported! Use raw links only.", true, false)
        return
    end
    
    if not (rawLink:sub(1, 7) == "http://" or rawLink:sub(1, 8) == "https://") then
        setStatus("Invalid link! Use http:// or https://", true, false)
        return
    end
    
    setStatus("📡 Fetching content from link...", false, false)
    
    -- Attempt to fetch content with timeout handling
    local success, content = pcall(function()
        return game:HttpGet(rawLink)
    end)
    
    if not success then
        setStatus("❌ Failed to fetch! Link may be invalid or blocked.", true, false)
        return
    end
    
    if not content or content == "" then
        setStatus("❌ Empty response from server!", true, false)
        return
    end
    
    -- Validate content isn't an error page
    local valid, errorMsg = isValidContent(content)
    if not valid then
        setStatus("❌ " .. errorMsg, true, false)
        return
    end
    
    setStatus("📋 Copying to clipboard...", false, false)
    
    -- Copy content to clipboard
    local clipboardSuccess, clipboardError = pcall(function()
        setclipboard(content)
    end)
    
    if clipboardSuccess then
        setStatus("✅ Script copied to clipboard! (" .. #content .. " bytes) ✅", false, true)
        showDone()
    else
        setStatus("❌ Clipboard failed: " .. tostring(clipboardError), true, false)
    end
end

-- Animate button (touch-friendly)
local function animateButton(btn)
    if not btn.Active and btn ~= verifyButton then return end
    local originalSize = btn.Size
    local tween = TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 3, originalSize.Y.Scale, originalSize.Y.Offset - 3)})
    tween:Play()
    tween.Completed:Wait()
    local tweenBack = TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {Size = originalSize})
    tweenBack:Play()
end

-- Touch/Drag handling for mobile
local dragging = false
local dragStart = Vector2.new()
local startPos = Vector2.new()

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos = Vector2.new(mainFrame.Position.X.Offset, mainFrame.Position.Y.Offset)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        local newX = startPos.X + delta.X
        local newY = startPos.Y + delta.Y
        mainFrame.Position = UDim2.new(0, newX, 0, newY)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

